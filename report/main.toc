\contentsline {paragraph}{Unbiased error is cheap until it is large.}{45}{section*.44}%
\contentsline {paragraph}{Price error costs through cycling, not through worse trades.}{45}{section*.45}%
\contentsline {paragraph}{The real forecasters lose far more than their MAE predicts.}{45}{section*.46}%
