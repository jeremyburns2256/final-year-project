\@writefile{lot}{\contentsline {table}{\numberline {7.5}{\ignorespaces Forecast accuracy and dispatch value, household scenario, $J=4$, January 2025. MAE is the mean absolute error of the price forecast over all lead times and rMAE is the MAE relative to the seasonal-naive forecast.\relax }}{41}{table.caption.31}\protected@file@percent }
